FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY pyproject.toml ./
COPY packages ./packages
COPY apps ./apps
COPY examples ./examples
RUN pip install --no-cache-dir -e "packages/florence-core" \
                                -e "packages/florence-edena" \
                                "fastapi>=0.110" "uvicorn[standard]>=0.29" \
                                "sqlalchemy>=2" "psycopg[binary]>=3" "alembic>=1.13" \
                                "opentelemetry-sdk>=1.20" "opentelemetry-exporter-otlp-proto-http>=1.20" \
                                "langgraph>=1,<2" "langgraph-checkpoint-postgres>=2"
WORKDIR /app/apps/api
EXPOSE 8000
# Apply migrations to the configured database (no-op when FLORENCE_DATABASE_URL
# is unset and the app falls back to the in-memory repository), then serve.
CMD ["sh", "-c", "if [ -n \"$FLORENCE_DATABASE_URL\" ]; then alembic upgrade head; fi && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
