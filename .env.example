# Empty DATABASE_URL => in-memory repository (MVP default).
FLORENCE_DATABASE_URL=
FLORENCE_REDIS_URL=
# Empty EDENA_BASE_URL => in-process LocalRuleBackend. Set to http://localhost:8181 for OPA.
EDENA_BASE_URL=
FLORENCE_REQUIRE_IDENTITY=true
FLORENCE_EXAMPLES_DIR=examples
FLORENCE_EVENT_LOG=.florence/events.jsonl
